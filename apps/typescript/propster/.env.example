# ---------------------------------------------------------------------------
# Propster environment.
#
# Copy to `.env` and fill in. Never commit `.env`.
#
# Everything here is read server-side only. Nothing is prefixed NEXT_PUBLIC_,
# and `src/server/env.ts` imports "server-only", so the build fails if server
# configuration is ever pulled into a client bundle.
#
# The file is ordered by what you actually have to set:
#   REQUIRED    five variables, verified sufficient to boot and run
#   AFTER DEPLOY  two more, once you know your public URL
#   LOCAL ONLY  needed to seed or migrate, never on the host
#   DEFAULTS    documented for completeness; leave unset unless changing them
# ---------------------------------------------------------------------------


# === REQUIRED ==============================================================
# These five are all a deployment needs.

# Neon POOLED connection (host contains "-pooler"). Serverless hosts must use
# the pooled endpoint.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# CALL-E. With this set, verifying a property places a REAL outbound call.
# Leave empty and Propster runs the whole workflow against its deterministic
# simulated provider instead.
CALLE_API_KEY=""

# Language model for requirement and transcript extraction. Without a key the
# deterministic parser is used, which is markedly weaker on garbled speech.
# Run `npm run llm:check` to grade the models your key can reach.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Guard rail: only these E.164 numbers may be dialled. Strongly recommended in
# any deployment reachable from the internet. Empty means no restriction.
# A number a visitor submitted through /try with explicit consent bypasses this
# list, because it is their own phone.
CALLE_PHONE_ALLOWLIST=""


# === AFTER DEPLOY ==========================================================
# Set these once the app has a public HTTPS URL. Without them CALL-E results
# are collected by polling, which works but is slower.

# No trailing slash, e.g. https://propster.vercel.app
PUBLIC_APP_URL=""

# A long random string you invent, NOT anything from your CALL-E account.
# CALL-E deliveries are unsigned, so this unguessable path segment is what
# authenticates the webhook receiver.
CALLE_WEBHOOK_TOKEN=""


# === LOCAL ONLY ============================================================
# Used by the Prisma CLI and the seed script. Never needed on the host: the
# seeded data already lives in the database.

# Neon DIRECT connection (the pooled host without "-pooler"). Required by
# `prisma db push`, because pgBouncer cannot run the DDL it issues.
DIRECT_DB_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# E.164 number for the one seeded listing that may be dialled for real. Read by
# `npm run db:seed` only. Leave empty and every seeded listing keeps a
# fictional number that cannot be called.
DEMO_AGENT_PHONE=""


# === DEFAULTS ==============================================================
# All optional. The value shown is what the app uses when the variable is
# absent, so set one only to change it.

# "auto" prefers Groq when a Groq key is present, Anthropic otherwise.
# LLM_PROVIDER="auto"

# "true" forces the simulated phone provider even with a CALL-E key present.
# Useful for a demo that must not dial, and for CI.
# PROPSTER_DEMO_MODE="false"

# CALLE_BASE_URL="https://api.heycall-e.com"   # or https://test-api.heycall-e.com
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
