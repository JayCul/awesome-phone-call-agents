{
  "name": "propster",
  "version": "1.0.0",
  "private": true,
  "description": "AI property verification and discovery. Searches listings, then calls the agent to verify them.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma db push && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "calle:smoke": "tsx --env-file-if-exists=.env scripts/calle-smoke.mts",
    "vendor:images": "tsx --env-file-if-exists=.env scripts/vendor-images.mts",
    "llm:check": "tsx --env-file-if-exists=.env scripts/llm-check.mts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@call-e/calle": "^0.7.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
